# Olea API configuration. Copy to .env and fill in values for local runs.
# In Docker, these are provided by docker-compose.

# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database (libsql file URL)
DATABASE_URL=file:./data/olea.sqlite

# Google Gemini (AI Studio free tier). Leave GEMINI_API_KEY empty to run the
# assistant on the deterministic rule-based engine. Add a key to enable the LLM.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
