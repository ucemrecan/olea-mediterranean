# Olea web configuration. Copy to .env for local runs (gitignored).
# On Vercel, set these in Project Settings → Environment Variables.

# Google Gemini (AI Studio free tier). Leave GEMINI_API_KEY empty to run the
# assistant on the deterministic rule-based engine. Add a key to enable the LLM.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
