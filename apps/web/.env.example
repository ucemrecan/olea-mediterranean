# Olea web configuration. In Docker these are provided by docker-compose.

# Data source: "api" (default) talks to the backend; "mock" uses bundled data.
NEXT_PUBLIC_DATA_SOURCE=api

# API base URL used by the browser (client components, e.g. the assistant).
NEXT_PUBLIC_API_URL=http://localhost:4000

# API base URL used by the Next.js server (SSR). Inside Docker this is the
# api service hostname; outside Docker it matches NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=http://localhost:4000
